{
  "schema_version": 2,
  "package_name": "gaps_edge_schema_v2_example",
  "dataset_profile": "replace_with_dataset_profile",
  "device_profile": "replace_with_device_profile",
  "model_backend": "torchscript",
  "model_file": "model.ts",
  "input": {
    "sensor_fields": [
      "adc_ch0_pa0",
      "adc_ch1_pa1",
      "adc_ch2_pa2",
      "adc_ch3_pa3",
      "adc_ch4_pa4",
      "adc_ch5_pa5",
      "adc_ch6_pa6",
      "adc_ch7_pa7"
    ],
    "feature_mode": "relative_adc",
    "raw_sample_hz": 10.0,
    "target_sample_hz": 10.0,
    "unstable_duration_s": 20.0,
    "baseline_duration_s": 30.0,
    "window_duration_s": 10.0,
    "stride_duration_s": 5.0,
    "min_rate_ratio": 0.7,
    "max_rate_ratio": 1.3,
    "allow_rate_mismatch": false,
    "max_gap_s": 1.0,
    "reject_implausible_frames": true
  },
  "normalization": {
    "enabled": false
  },
  "phase_control": {
    "mode": "event_driven",
    "inference_phases": [
      "exposure",
      "recovery"
    ]
  },
  "output": {
    "gas_names": [
      "Ethanol",
      "CO",
      "Ethylene",
      "Methane"
    ]
  },
  "qc": {
    "policy_name": "replace_with_frozen_qc",
    "min_confidence": 0.7,
    "accept_max_risk": 0.3,
    "reject_min_risk": 0.6,
    "low_confidence_decision": "review",
    "risk_score_name": "model_or_classifier_risk"
  },
  "calibration": {
    "per_class": {}
  }
}
