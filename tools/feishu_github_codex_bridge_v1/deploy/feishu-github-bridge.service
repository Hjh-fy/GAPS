[Unit]
Description=Feishu GitHub Bridge v1
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/feishu_github_codex_bridge_v1
EnvironmentFile=/opt/feishu_github_codex_bridge_v1/.env
ExecStart=/opt/feishu_github_codex_bridge_v1/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
