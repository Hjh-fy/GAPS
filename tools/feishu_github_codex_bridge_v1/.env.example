# ===== Feishu / Lark =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
# Strongly recommended for production webhook signature verification.
# If empty, the service still checks Verification Token when present.
FEISHU_ENCRYPT_KEY=

# ===== GitHub =====
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=GAPS
GITHUB_API_VERSION=2026-03-10

# ===== Service =====
APP_ENV=dev
LOG_LEVEL=INFO
ISSUE_DEFAULT_LABELS=codex-task,needs-review
AUTO_MENTION_CODEX=false
CODEX_TRIGGER_TEXT=@codex Please implement this task. Follow AGENTS.md and keep the PR small and reviewable.
